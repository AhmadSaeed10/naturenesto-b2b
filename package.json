{
  "name": "naturenesto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "contrast": "node scripts/contrast.ts",
    "predev": "npm run tokens",
    "dev": "next dev",
    "prebuild": "npm run tokens",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:generate": "node --import ./scripts/lib/resolve-ts.ts scripts/seed-content.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db/seed.ts",
    "db:check": "node --env-file-if-exists=.env.local scripts/db/check.ts",
    "db:smoke": "node --env-file-if-exists=.env.local scripts/db/smoke.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
