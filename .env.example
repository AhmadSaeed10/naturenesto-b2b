# Copy to .env.local for local development. Never commit real values.

# Canonical site origin, used for metadataBase, Open Graph and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://naturenesto.com

# Keystatic (the Git CMS at /keystatic). Leave unset locally: it edits files on disk.
# On Vercel set it to "github" so editors sign in with GitHub and saves become commits.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
# Created by Keystatic's GitHub App setup (open /keystatic once in github mode). Server only.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Order, bulk quote and enquiry emails via Resend (resend.com). Server only.
# Without them, orders and quotes fall back to a prefilled WhatsApp message.
RESEND_API_KEY=
# A sender on a domain verified in Resend, for example: Nature Nesto <orders@naturenesto.com>
ORDER_EMAIL_FROM=
# Store inbox for orders and quotes. Defaults to the site email (info@naturenesto.com).
ORDER_EMAIL_TO=
