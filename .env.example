# Copy to .env.local for local development. Never commit real values.

# Canonical site origin, used for metadataBase, Open Graph, sitemap URLs and sign in links.
NEXT_PUBLIC_SITE_URL=https://naturenesto.com

# Neon Postgres (Neon console > project > Connect). Server only, never prefix with NEXT_PUBLIC_.
# DATABASE_URL is the pooled string (host contains "-pooler"), used by the app.
# DATABASE_URL_UNPOOLED is the direct string, used by npm run db:migrate and db:seed.
# Without DATABASE_URL the storefront keeps showing the sample catalogue.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Sign in (Better Auth). Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_URL is the origin people use (http://localhost:3000 in development).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend). Without a key, sign in links are printed in the terminal in development.
# RESEND_API_KEY=
# EMAIL_FROM="NatureNesto <login@your-verified-domain.com>"

# Media storage (any S3 compatible bucket with public reads: Neon Object Storage, Cloudflare R2).
# The bucket needs a CORS rule that lets your site origin PUT. See docs/NEON.md.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=naturenesto-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket (no trailing slash). Also used for next/image.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com
