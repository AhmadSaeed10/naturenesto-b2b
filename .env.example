# Copy to .env.local for local development. Never commit real values.

# Canonical site origin, used for metadataBase, Open Graph, sitemap URLs and auth links.
NEXT_PUBLIC_SITE_URL=https://naturenesto.com

# Neon Postgres (Neon console > project > Connect). Server only, never prefix with NEXT_PUBLIC_.
# DATABASE_URL is the pooled string (host contains "-pooler"), used by the app.
# DATABASE_URL_UNPOOLED is the direct string, used by npm run db:migrate and db:seed.
# Without DATABASE_URL the storefront keeps showing the sample catalogue.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Legacy, removed when the move to Neon is finished (see docs/NEON.md).
# Supabase project (Project Settings > API). The URL and anon key are public by design:
# RLS decides what they can read. Without them the storefront shows the sample catalogue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS: never prefix with NEXT_PUBLIC_ and never import it in a
# component. Used for admin sign in, rate limits, lead capture and checkout.
SUPABASE_SERVICE_ROLE_KEY=

# CI only (GitHub Actions secrets, not Vercel): used by the old `supabase db push` on merge.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
